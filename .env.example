# DocMind 环境变量示例：复制为 .env 后按需修改

# ---- 服务 ----
DOCMIND_ENV=development
DOCMIND_HOST=0.0.0.0
DOCMIND_PORT=8000

# ---- 数据库 ----
# 默认 SQLite，开箱即用；生产建议 postgresql+psycopg://user:pass@host:5432/docmind
DOCMIND_DATABASE_URL=sqlite:///./docmind.db

# ---- 鉴权 ----
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
DOCMIND_JWT_SECRET=dev-only-change-me-please-32bytes-min
DOCMIND_JWT_TTL_SECONDS=7200

# ---- 大模型 ----
# demo = 不调用任何外部模型，用检索结果拼装回答（便于离线演示 / 跑测试）
# openai = 任意 OpenAI 兼容接口（DeepSeek / 通义 / vLLM / Ollama 均可）
DOCMIND_LLM_PROVIDER=demo
DOCMIND_LLM_MODEL=deepseek-chat
DOCMIND_LLM_BASE_URL=https://api.deepseek.com/v1
DOCMIND_LLM_API_KEY=sk-xxxx
DOCMIND_LLM_TEMPERATURE=0.2

# ---- 向量化 ----
# hashing = 本地哈希向量（零依赖、确定性、可离线）；openai = 调用 /v1/embeddings
DOCMIND_EMBEDDING_PROVIDER=hashing
DOCMIND_EMBEDDING_DIM=384

# ---- 检索 ----
DOCMIND_CHUNK_SIZE=420
DOCMIND_CHUNK_OVERLAP=80
DOCMIND_TOP_K=5

# ---- 限流 ----
DOCMIND_RATE_LIMIT_PER_MINUTE=120
